{
  "name": "scichart-angular-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "test-storybook --url http://localhost:6006",
    "test:stories": "test-storybook --url http://localhost:6006",
    "test:visual": "playwright test",
    "update-snapshots": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "buildLib": "ng build scichart-angular",
    "verifyPackage": "publint dist/scichart-angular && attw --pack dist/scichart-angular --ignore-rules unexpected-module-syntax cjs-resolves-to-esm false-cjs",
    "storybook": "ng run scichart-angular-app:storybook"
  },
  "private": true,
  "overrides": {
    "@swc/core": "^1.16.2"
  },
  "dependencies": {
    "@angular/animations": "^17.1.0",
    "@angular/common": "^17.1.0",
    "@angular/compiler": "^17.1.0",
    "@angular/core": "^17.1.0",
    "@angular/forms": "^17.1.0",
    "@angular/platform-browser": "^17.1.0",
    "@angular/platform-browser-dynamic": "^17.1.0",
    "@angular/router": "^17.1.0",
    "rxjs": "~7.8.0",
    "scichart": "6.0.0-alpha.196",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.1.2",
    "@angular/cli": "^17.1.2",
    "@angular/compiler-cli": "^17.1.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-essentials": "^7.6.17",
    "@storybook/addon-interactions": "^7.6.17",
    "@storybook/addon-links": "^7.6.17",
    "@storybook/angular": "^7.6.17",
    "@storybook/blocks": "^7.6.17",
    "@storybook/test": "^7.6.17",
    "@storybook/test-runner": "^0.16.0",
    "ng-packagr": "^17.1.0",
    "publint": "^0.3.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^7.6.17",
    "typescript": "~5.3.2"
  }
}
